# FixFlow Development Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Backend Server Networking
PORT=3001
HOST=0.0.0.0
NODE_ENV=development # Set to 'production' on Render / Railway

# CORS Allowed Origins
# In development: allows localhost and 127.0.0.1 on any port.
# In production: provide a comma-separated list of exact approved browser origins.
# fixflow-ai-home-repair-agent.vercel.app is allowed by default; add any custom or preview domains.
# Example: CORS_ORIGIN=https://fixflow-ai-home-repair-agent.vercel.app
CORS_ORIGIN=http://localhost:5173

# Persistent Storage & Database Configuration
# Local Development: defaults to ./database/data/fixflow.db
# Production (Railway with volume mounted at /data):
#   DATA_DIR=/data
#   INSPECTIONS_UPLOADS_DIR=/data/uploads/inspections
# IMPORTANT: In production, do NOT set DATABASE_PATH to a local relative path,
# as it would override the persistent location derived from DATA_DIR (/data/fixflow.db).
# DATA_DIR=/data
# INSPECTIONS_UPLOADS_DIR=/data/uploads/inspections
SESSION_SECRET=replace-with-a-secure-random-secret-for-production

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:3001

# FixFlow AI Repair Assistant (Phase 3) Configuration
# Optional: Set an external LLM API key. If omitted, FixFlow automatically runs
# in deterministic offline simulator mode with structured tool execution.
# LLM_PROVIDER=gemini # 'gemini' | 'openai' | 'anthropic' | 'simulator'
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MCP_SERVER_URL=http://127.0.0.1:3002/mcp
