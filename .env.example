# FixFlow Development Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Backend Server Configuration
PORT=3001
NODE_ENV=development
DATABASE_PATH=./database/data/fixflow.db
SESSION_SECRET=replace-with-a-secure-random-secret-for-production
CORS_ORIGIN=http://localhost:5173

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:3001

# FixFlow AI Repair Assistant (Phase 3) Configuration
# Optional: Set an external LLM API key. If omitted, FixFlow automatically runs
# in deterministic offline simulator mode with structured tool execution.
# LLM_PROVIDER=gemini # 'gemini' | 'openai' | 'anthropic' | 'simulator'
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MCP_SERVER_URL=http://127.0.0.1:3002/mcp
