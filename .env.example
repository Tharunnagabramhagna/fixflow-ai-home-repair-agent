# FixFlow Development Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Backend Server Configuration
PORT=3001
NODE_ENV=development
DATABASE_PATH=./database/data/fixflow.db
SESSION_SECRET=replace-with-a-secure-random-secret-for-production
CORS_ORIGIN=http://localhost:5173

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:3001
